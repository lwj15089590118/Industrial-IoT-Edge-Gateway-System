-- ============================================================================
-- influxdb_init.iql — InfluxDB 时序数据库初始化脚本
-- ----------------------------------------------------------------------------
-- 用法（容器首次启动后执行一次）：
--   influx -host 127.0.0.1 -port 8086 -execute "file" 或逐条执行本文件
--   Docker 环境：docker exec -it iiot-influxdb influx < /docker-entrypoint-initdb.d/influxdb_init.iql
--   （docker-compose 已将本文件挂载为自动初始化脚本，容器首启时自动执行）
-- ============================================================================

-- 1. 创建业务数据库：存储工厂电力测点时序数据
CREATE DATABASE "factory_metrics";

-- 2. 创建保留策略：
--    名称   rp_30d     —— 保留 30 天，单节点副本
--    语义   历史 30 天自动过期清理，控制磁盘占用（1 秒 1 条 × 10 测点 ≈ 每天 86 万字段点）
CREATE RETENTION POLICY "rp_30d" ON "factory_metrics"
    DURATION 30d REPLICATION 1 DEFAULT;

-- 3. 关于 5 分钟降采样连续查询（cq_metrics_5m）：
--    曾经在此创建指向 metrics_5m 的连续查询，但全项目没有任何查询方使用该表
--    （/api/history 固定查原始 metrics 表，大跨度查询由前端自适应聚合窗口兜底），
--    属于"建而不用"的死数据。已移除该 CQ；后续若接入降采样查询链路，再在此恢复：
--    CREATE CONTINUOUS QUERY "cq_metrics_5m" ON "factory_metrics"
--    BEGIN SELECT mean(*) INTO "factory_metrics"."rp_30d"."metrics_5m"
--    FROM "factory_metrics"."rp_30d"."metrics" GROUP BY time(5m), "device_id" END;

-- 4. 验证：查看数据库与保留策略是否创建成功
SHOW DATABASES;
SHOW RETENTION POLICIES ON "factory_metrics";
